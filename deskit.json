{
  "$schema": "./schema/deskit-manifest.schema.json",
  "id": "com.deskit.clipboard-history",
  "name": "clipboard-history",
  "displayName": {
    "en": "Clipboard History",
    "zh-CN": "历史剪贴板"
  },
  "description": {
    "en": "Collect recent clipboard items and copy them back from the launcher.",
    "zh-CN": "记录最近的剪贴板内容，并可从启动器快速复制。"
  },
  "version": "0.4.1",
  "author": "DesKit",
  "icon": "lucide:clipboard-list",
  "engines": {
    "deskit": "^0.2.0"
  },
  "main": "dist/index.js",
  "contributes": {
    "activationEvents": [
      "clipboard:change"
    ],
    "commands": [
      {
        "id": "clipboard-history.open",
        "title": {
          "en": "Clipboard History",
          "zh-CN": "历史剪贴板"
        },
        "subtitle": {
          "en": "Pick a recent clipboard item to copy",
          "zh-CN": "选择最近的剪贴板项目并复制"
        },
        "keywords": [
          "clipboard",
          "history",
          "copy",
          "剪贴板",
          "历史",
          "复制"
        ],
        "icon": "lucide:clipboard-list",
        "mode": "view"
      }
    ],
    "preferences": [
      {
        "id": "openShortcut",
        "type": "shortcut",
        "label": {
          "en": "Open shortcut",
          "zh-CN": "打开快捷键"
        },
        "default": "Super+Control+C",
        "command": "clipboard-history.open"
      },
      {
        "id": "maxItems",
        "type": "select",
        "label": {
          "en": "Maximum history items",
          "zh-CN": "最大历史条数"
        },
        "default": "50",
        "options": [
          {
            "value": "20",
            "label": "20"
          },
          {
            "value": "50",
            "label": "50"
          },
          {
            "value": "100",
            "label": "100"
          }
        ]
      },
      {
        "id": "captureImages",
        "type": "checkbox",
        "label": {
          "en": "Capture image clipboard entries",
          "zh-CN": "记录图片剪贴板"
        },
        "default": true
      },
      {
        "id": "syncProvider",
        "type": "select",
        "label": {
          "en": "Sync provider",
          "zh-CN": "同步方式"
        },
        "default": "off",
        "options": [
          {
            "value": "off",
            "label": {
              "en": "Off",
              "zh-CN": "关闭"
            }
          },
          {
            "value": "gist",
            "label": {
              "en": "DesKit settings sync (Gist)",
              "zh-CN": "DesKit 设置同步（Gist）"
            }
          },
          {
            "value": "webdav",
            "label": "WebDAV"
          }
        ]
      },
      {
        "id": "webdavUrl",
        "type": "text",
        "label": {
          "en": "WebDAV root URL",
          "zh-CN": "WebDAV 根 URL"
        },
        "default": ""
      },
      {
        "id": "webdavUsername",
        "type": "text",
        "label": {
          "en": "WebDAV username",
          "zh-CN": "WebDAV 用户名"
        },
        "default": ""
      },
      {
        "id": "webdavPassword",
        "type": "text",
        "label": {
          "en": "WebDAV password or app token",
          "zh-CN": "WebDAV 密码或应用令牌"
        },
        "default": ""
      },
      {
        "id": "webdavPath",
        "type": "text",
        "label": {
          "en": "WebDAV sync file path",
          "zh-CN": "WebDAV 同步文件路径"
        },
        "default": "deskit/clipboard-history.json"
      }
    ]
  },
  "permissions": [
    "clipboard:read",
    "clipboard:write",
    "storage:plugin",
    "sync:plugin",
    "network:http"
  ]
}
